// Password spray against Entra ID
// MITRE ATT&CK: T1110.003 Password Spraying
// Logic: one source IP failing sign-in for many distinct accounts in a short window.
// Known false positives: shared egress IPs such as VPN or proxy, misconfigured service accounts.
// Tuning: exclude known egress IPs with a watchlist and raise the threshold if your baseline is noisy.
let lookback = 1h;
let min_accounts = 15;
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType in ("50126", "50053")   // invalid password, account locked
| summarize
    FailedAccounts = dcount(UserPrincipalName),
    Attempts = count(),
    SampleUsers = make_set(UserPrincipalName, 10),
    Apps = make_set(AppDisplayName, 5),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress, Location = tostring(LocationDetails.countryOrRegion)
| where FailedAccounts >= min_accounts
| join kind=leftouter (
    SigninLogs
    | where TimeGenerated > ago(lookback)
    | where ResultType == "0"
    | summarize SuccessfulUsers = make_set(UserPrincipalName, 10) by IPAddress
  ) on IPAddress
| project FirstSeen, LastSeen, IPAddress, Location, FailedAccounts, Attempts, SampleUsers, SuccessfulUsers, Apps
| order by FailedAccounts desc
